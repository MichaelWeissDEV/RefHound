# Maintainer: Michael Weiss <michael@example.invalid>
pkgname=refhound
pkgver=0.1.0b1
pkgrel=1
pkgdesc="Git repository security and forensic analysis tool"
arch=('any')
url="https://github.com/MichaelWeissDEV/RefHound"
license=('MIT')
depends=(
  'git'
  'python>=3.12'
  'python-httpx>=0.27'
  'python-platformdirs>=4.2'
  'python-pydantic>=2.6'
  'python-rich>=13.7'
  'python-sqlalchemy>=2.0'
  'python-typer>=0.12'
  'python-yaml>=6.0'
)
makedepends=(
  'python-build'
  'python-hatchling'
  'python-installer'
  'python-wheel'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('1d59d5470c3cdcceb2673d3daa5fdfd91a7ac052fd9ec729fea8f8cedc5bf473')

# Local builds (CI) can point at an already-created tarball instead of
# downloading the release from GitHub.
if [[ -n ${REFHOUND_LOCAL_TARBALL:-} ]]; then
  # makepkg only accepts local sources as file:// URLs.
  source=("file://$REFHOUND_LOCAL_TARBALL")
  # This override is for a locally created CI archive, not for AUR publishing.
  sha256sums=("$(sha256sum "$REFHOUND_LOCAL_TARBALL" | cut -d' ' -f1)")
fi

prepare() {
  cd "$srcdir"
  rm -rf "RefHound-$pkgver"
  tar -xf "$pkgname-$pkgver.tar.gz"
}

build() {
  cd "RefHound-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "RefHound-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
