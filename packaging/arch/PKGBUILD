# Maintainer: Michael Weiss <michael@example.invalid>
pkgname=refhound
pkgver=0.1.0
pkgrel=1
pkgdesc="Git repository security and forensic analysis tool"
arch=('any')
url="https://github.com/MichaelWeissDEV/RefHound"
license=('MIT')
depends=(
  'git'
  'python>=3.12'
  'python-httpx>=0.27'
  'python-platformdirs>=4.2'
  'python-pydantic>=2.6'
  'python-rich>=13.7'
  'python-sqlalchemy>=2.0'
  'python-typer>=0.12'
  'python-yaml>=6.0'
)
makedepends=(
  'python-build'
  'python-hatchling'
  'python-installer'
  'python-wheel'
)
source=("$pkgname-$pkgver.tar.gz::https://files.pythonhosted.org/packages/source/r/$pkgname/$pkgname-$pkgver.tar.gz")
# SHA-256 of the candidate sdist; verify again against the PyPI file after
# publication. The PKGBUILD is excluded from the sdist to avoid a hash loop.
sha256sums=('a3a86c307f38ce5f2999a024e7b7452d2217535e2ef7fe811825a2bc7bd3af4d')

# Local builds (CI) can point at an already-created tarball instead of
# downloading the release from GitHub.
if [[ -n ${REFHOUND_LOCAL_TARBALL:-} ]]; then
  # makepkg only accepts local sources as file:// URLs.
  source=("file://$REFHOUND_LOCAL_TARBALL")
  # This override is for a locally created CI archive, not for AUR publishing.
  sha256sums=("$(sha256sum "$REFHOUND_LOCAL_TARBALL" | cut -d' ' -f1)")
fi

prepare() {
  cd "$srcdir"
  rm -rf "$pkgname-$pkgver" "RefHound-$pkgver"
  tar -xf "$pkgname-$pkgver.tar.gz"
  # The local CI source archive uses a GitHub-style capitalized root.
  if [[ -d "RefHound-$pkgver" ]]; then
    mv "RefHound-$pkgver" "$pkgname-$pkgver"
  fi
}

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
